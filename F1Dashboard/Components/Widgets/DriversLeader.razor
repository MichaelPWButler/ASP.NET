@using F1Dashboard.Models
@inject IDataService DataService

@if (_Driver != null)
{
    <div class="card">
        <div class="driver-headshot">
            <img src="DriverImages/@(_Driver.FamilyName).webp" title="@(_Driver.GivenName) @(_Driver.FamilyName)" />
        </div>

        <h3>Championship Leader</h3>
    </div> 
}


@code {
    public DriverModel? _Driver;

    protected override async Task OnInitializedAsync()
    {
        _Driver = await DataService.GetDriversLeaderAsync();
    }
}
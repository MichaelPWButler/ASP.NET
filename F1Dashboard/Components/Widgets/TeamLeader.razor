@using F1Dashboard.Models
@inject IDataService DataService

@if (_Team != null)
{
    <div class="card card-square">
        <div class="team-image">
            <img src="TeamImages/@(_Team.Name).svg" title="@(_Team.Name)" />
        </div>

        <h3>Constructors Leader</h3>
    </div>
}

@code {
    public ConstructorModel? _Team;

    protected override async Task OnInitializedAsync()
    {
        _Team = await DataService.GetConstructorsLeaderAsync();
    }
}

@using F1Dashboard.Models
@inject IDataService DataService

<div class="card">
    <h3>Next GP</h3>
    <div class="flag-img">
        <img src="https://flagcdn.io/@(_NextRace.CountryCode).svg" />
    </div>
    <h3>@_NextRace.Country</h3>
    <p>@_NextRace.Date.ToString("dd MMMM yyyy")</p>
</div>

@code {
    public RaceModel? _NextRace;

    protected override async Task OnInitializedAsync()
    {
        _NextRace = DataService.GetNextRace();
    }
}

@using F1Dashboard.Models
@inject IDataService DataService

@if (_Driver != null)
{
    <div class="card card-rectangle">
        <div class="driver-headshot">
            <img src="DriverImages/@(_Driver.FamilyName).webp" title="@(_Driver.GivenName) @(_Driver.FamilyName)" />
        </div>

        <h3>Most Points in Last 5 Races</h3>
    </div>
}


@code {
    public TopDriverLast5Races? _Driver;

    protected override async Task OnInitializedAsync()
    {
        _Driver = await DataService.GetMostPointsInLastFiveRaces();
    }
}
